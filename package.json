{
  "name": "dsh-prompt-polish",
  "version": "0.3.0",
  "description": "DSH 输入框一键优化：点一颗星就地改写草稿，深度自动判断，随时可撤销。One-tap prompt polishing for the DeepSeek Harness web composer.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/typert.host.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "prompt",
    "composer",
    "polish",
    "rewrite"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-prompt-polish",
    "summary": "输入框一键优化：一颗星就地改写草稿，自动判断改多深，留撤销口，保留 @引用/代码/URL 与原意。",
    "categories": ["Web UI", "提示词", "效率"],
    "surfaces": ["host", "web"],
    "capabilities": {
      "provides": ["service:promptPolish"]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2",
      "node": ">=20"
    },
    "permissions": {
      "network": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaosiw/dsh-prompt-polish.git"
  },
  "homepage": "https://github.com/zhaosiw/dsh-prompt-polish#readme",
  "bugs": {
    "url": "https://github.com/zhaosiw/dsh-prompt-polish/issues"
  },
  "author": "zhaosiw",
  "license": "MIT"
}
